# Copy this to .env.local for local development. On Vercel, the
# Clerk and Neon Marketplace integrations inject most of these automatically.

# Anthropic
ANTHROPIC_API_KEY=

# Clerk — server-side (auto-injected by Clerk Vercel integration)
CLERK_SECRET_KEY=

# Clerk — client-side. Vite needs the VITE_ prefix; vite.config.js falls
# back to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (which the Clerk integration sets).
VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Neon Postgres (auto-injected by Neon Vercel integration)
DATABASE_URL=
